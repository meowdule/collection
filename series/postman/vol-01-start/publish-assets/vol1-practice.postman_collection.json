      "item": [
        {
          "name": "GET Echo 테스트",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://postman-echo.com/get?source=vol1-practice",
              "protocol": "https",
              "host": ["postman-echo.com"],
              "path": ["get"],
              "query": [
                {
                  "key": "source",
                  "value": "vol1-practice"
                }
              ]
            },
            "description": "Import 직후 Send를 눌러 200 응답이 오면 연결 테스트 성공입니다."
